local function OFBCBY_fake_script() -- Knob.LocalScript 
	local script = Instance.new('LocalScript', Knob)

	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Debris = game:GetService("Debris")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local inputService = game:GetService("UserInputService")

	local knob = script.Parent
	local sliderBar = knob.Parent
	local filling = sliderBar:FindFirstChild("Filling")
	local valueLabel = sliderBar.Parent:FindFirstChild("TextLabel") or sliderBar.Parent:FindFirstChildWhichIsA("TextLabel")

	local dragging = false
	_G.CurrentSizeValue = 1
	_G.BigheadMasterState = false

	local function startBypass()
		for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
			if obj.Name == "Unknown" then
				obj:Destroy()
			end
		end
		ReplicatedStorage.DescendantAdded:Connect(function(obj)
			if obj.Name == "Unknown" then
				obj:Destroy()
			end
		end)
		task.wait(0.5)
		_G.BigheadMasterState = true
	end

	local function applyESPAndLogic(player)
		if player == Players.LocalPlayer then return end
		local function updateCharacter(char)
			local highlight = char:FindFirstChild("Highlight") or Instance.new("Highlight")
			highlight.Name = "Highlight"
			highlight.FillTransparency = 1
			highlight.OutlineColor = Color3.fromRGB(0, 0, 127)
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = char
		end
		player.CharacterAdded:Connect(updateCharacter)
		if player.Character then updateCharacter(player.Character) end
	end

	_G.ApplyToPlayer = function(v)
		if v ~= Players.LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
			pcall(function()
				local head = v.Character.Head
				local s = _G.CurrentSizeValue
				head.Size = Vector3.new(s, s, s)
				head.Transparency = 0.4
				head.BrickColor = BrickColor.new("Really red")
				head.Material = Enum.Material.Neon
				head.CanCollide = false
				head.Massless = true
			end)
		end
	end

	knob.MouseButton1Down:Connect(function() dragging = true end)
	inputService.InputEnded:Connect(function(input) 
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end 
	end)

	RunService.RenderStepped:Connect(function()
		if _G.BigheadMasterState then
			for _, p in ipairs(Players:GetPlayers()) do
				_G.ApplyToPlayer(p)
			end
		end
		if dragging then
			local mouseX = inputService:GetMouseLocation().X
			local percent = math.clamp((mouseX - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
			knob.Position = UDim2.new(percent, 0, 0.5, 0)
			if filling then filling.Size = UDim2.new(percent, 0, 1, 0) end
			_G.CurrentSizeValue = math.floor(1 + (9 * percent))
			if valueLabel then valueLabel.Text = tostring(_G.CurrentSizeValue) end
		end
	end)

	startBypass()
	for _, p in ipairs(Players:GetPlayers()) do applyESPAndLogic(p) end
	Players.PlayerAdded:Connect(applyESPAndLogic)
end
coroutine.wrap(OFBCBY_fake_script)()
